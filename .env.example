# ---- Choose ONE chat provider: groq | google | openai ----
LLM_PROVIDER=groq
# Optional: override the default model of the chosen provider
# LLM_MODEL=llama-3.3-70b-versatile

# ---- API keys (only the one you use is required) ----
GROQ_API_KEY=
GOOGLE_API_KEY=
OPENAI_API_KEY=

# ---- Embeddings for Task 2 / Task 4 (RAG) ----
# local  = free, runs on your machine (default, no key needed)
# google | openai = hosted embeddings
EMBEDDINGS_PROVIDER=local

# ---- Optional: better web search for Task 3 ----
TAVILY_API_KEY=
